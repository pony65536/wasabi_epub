# Primary provider/model
PRIMARY_PROVIDER=qwen
PRIMARY_MODEL=qwen-plus

# Optional backward-compatible aliases
PROVIDER=qwen

# Optional content-policy fallback
FALLBACK_ON_CONTENT_POLICY=true
FALLBACK_PROVIDER=openrouter
FALLBACK_MODEL=x-ai/grok-4.3

# Optional Russian glossary override
RUSSIAN_GLOSSARY_PROVIDER=openrouter
RUSSIAN_GLOSSARY_MODEL=mistralai/mistral-small-3.1-24b-instruct

# Optional Japanese glossary override
JAPANESE_GLOSSARY_PROVIDER=openrouter
JAPANESE_GLOSSARY_MODEL=anthropic/claude-sonnet-4.5

# Provider API keys
GEMINI_API_KEY=xxx
QWEN_API_KEY=xxx
MIMO_API_KEY=xxx
OPENROUTER_API_KEY=xxx

# Optional provider-specific models
# GEMINI_MODEL=gemini-2.5-pro
# QWEN_MODEL=qwen-plus
# MIMO_MODEL=mimo-v2-pro
# OPENROUTER_MODEL=x-ai/grok-4.3

# Optional provider-specific base URLs
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# MIMO_BASE_URL=https://api.xiaomimimo.com/v1
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional OpenRouter request tuning
# OPENROUTER_REASONING_ENABLED=true

# ===== Model config file (recommended for multi-stage routing) =====
# Create models.json (or point WASABI_MODELS_FILE at one) to define
# connections + models + per-stage routing. When present it takes
# precedence over the legacy env keys above.
#
# WASABI_MODELS_FILE=./models.json
#
# models.json sketch:
# {
#   "connections": {
#     "main": { "url": "https://relay.example/v1", "format": "openai-chat",
#               "tokenEnv": "MODEL_API_KEY", "concurrency": 3, "timeoutMs": 90000 }
#   },
#   "models": {
#     "normal":  { "connection": "main", "model": "model-A", "jsonMode": true, "maxOutputTokens": 4096 },
#     "careful": { "connection": "main", "model": "model-B", "jsonMode": true },
#     "backup":  { "connection": "main", "model": "model-C", "jsonMode": true }
#   },
#   "routing": {
#     "primary": "normal",
#     "fallback": "backup",
#     "stages": { "critic": "careful", "glossary": "careful" },
#     "stageFallback": { "critic": null },
#     "fallbackOnContentPolicy": true
#   }
# }
#
# Optional global concurrency cap (defaults to translation connection concurrency):
# WASABI_GLOBAL_CONCURRENCY=3

# Optional: Python executable for PDF mode
# Example (Windows):
# WASABI_PDF_PYTHON=C:\Users\name\miniconda3\envs\myenv\python.exe
# Example (macOS/Linux):
# WASABI_PDF_PYTHON=/opt/miniconda3/envs/myenv/bin/python

# Optional: PDF font overrides
# PDF_FONT_FILE=C:\path\to\font.ttf
# WASABI_PDF_FONT=C:\path\to\font.ttf
