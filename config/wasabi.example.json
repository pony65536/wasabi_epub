{
  "version": 1,
  "models": {
    "qwen-plus": {
      "sdk": "openai",
      "baseURL": "https://dashscope.aliyuncs.com/compatible-mode/v1",
      "apiKeyEnv": "QWEN_API_KEY",
      "modelName": "qwen-plus",
      "concurrency": 5,
      "timeoutMs": 90000
    },
    "mimo-v2-pro": {
      "sdk": "openai",
      "baseURL": "https://api.xiaomimimo.com/v1",
      "apiKeyEnv": "MIMO_API_KEY",
      "modelName": "mimo-v2-pro",
      "concurrency": 5,
      "timeoutMs": 90000
    },
    "grok-fallback": {
      "sdk": "openai",
      "baseURL": "https://openrouter.ai/api/v1",
      "apiKeyEnv": "OPENROUTER_API_KEY",
      "modelName": "x-ai/grok-4.3",
      "concurrency": 3,
      "timeoutMs": 120000,
      "requestOptions": {
        "reasoning": { "enabled": true }
      }
    },
    "ru-glossary": {
      "sdk": "openai",
      "baseURL": "https://openrouter.ai/api/v1",
      "apiKeyEnv": "OPENROUTER_API_KEY",
      "modelName": "mistralai/mistral-small-3.1-24b-instruct",
      "concurrency": 5,
      "timeoutMs": 90000
    },
    "ja-glossary": {
      "sdk": "openai",
      "baseURL": "https://openrouter.ai/api/v1",
      "apiKeyEnv": "OPENROUTER_API_KEY",
      "modelName": "anthropic/claude-sonnet-4.5",
      "concurrency": 5,
      "timeoutMs": 90000
    },
    "gemini-pro": {
      "sdk": "@google/generative-ai",
      "apiKeyEnv": "GEMINI_API_KEY",
      "modelName": "gemini-2.5-pro",
      "concurrency": 5,
      "timeoutMs": 90000
    }
  },
  "selection": {
    "primary": "qwen-plus",
    "stages": {},
    "stageFallback": {},
    "stageRequirements": {},
    "fallback": {
      "model": "grok-fallback",
      "onContentPolicy": true
    },
    "glossary": {
      "default": "qwen-plus",
      "bySourceLanguage": {
        "Russian": "ru-glossary",
        "Japanese": "ja-glossary"
      }
    }
  }
}
