# Model registration and selection live in config/wasabi.local.json.
# Copy config/wasabi.example.json to config/wasabi.local.json first.
# Optional: override the config path (relative to the project root)
# WASABI_CONFIG=config/wasabi.local.json

# API keys referenced by apiKeyEnv in config/wasabi.local.json
QWEN_API_KEY=xxx
MIMO_API_KEY=xxx
OPENROUTER_API_KEY=xxx
GEMINI_API_KEY=xxx

# Optional stage routing belongs in the registry's selection.stages, e.g.:
# "stages": { "critic": "gemini-pro", "glossary": "qwen-plus" }
# --model overrides only the translation stage.
# Legacy connections/models/routing files remain supported when explicitly selected:
# WASABI_MODELS_FILE=./models.json
# Do not set both WASABI_CONFIG and WASABI_MODELS_FILE.
# Without an explicit path, config/wasabi.local.json takes priority over legacy settings.
#
# Optional global concurrency cap (defaults to translation connection concurrency):
# WASABI_GLOBAL_CONCURRENCY=3

# Optional: Python executable for PDF mode
# Example (Windows):
# WASABI_PDF_PYTHON=C:\Users\name\miniconda3\envs\myenv\python.exe
# Example (macOS/Linux):
# WASABI_PDF_PYTHON=/opt/miniconda3/envs/myenv/bin/python

# Optional: PDF font overrides
# PDF_FONT_FILE=C:\path\to\font.ttf
# WASABI_PDF_FONT=C:\path\to\font.ttf
